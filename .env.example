# Copy to your shell / hosting provider's environment. Do NOT commit real values.

# --- Database (PostgreSQL) ---
DB_URL=jdbc:postgresql://localhost:5432/pgdb
DB_USER=pguser
DB_PASSWORD=change-me
# validate | update | none   (use a migration tool such as Flyway for production)
DDL_AUTO=update

# --- JWT --- at least 32 characters. Generate: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRY_HOURS=24
# how long after expiry a token may still be exchanged at /api/auth/refresh
JWT_REFRESH_GRACE_DAYS=7

# --- First SUPER_ADMIN, created on startup if none exists ---
BOOTSTRAP_ADMIN_USERNAME=superadmin
BOOTSTRAP_ADMIN_MOBILE=9999999999
BOOTSTRAP_ADMIN_PASSWORD=

# --- CORS: comma separated origins for web clients (native apps are not subject to CORS) ---
CORS_ORIGINS=http://localhost:8081,http://localhost:3000

PORT=8080
